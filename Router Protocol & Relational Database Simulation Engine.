import socket
import concurrent.futures
import time
import random

HOST = '127.0.0.1'

def send_simulation_request(port, min_ip, max_ip, min_db, max_db):
    # User-defined generation ranges
    if random.choice([True, False]):
        payload = f"ROUTE {random.randint(min_ip, max_ip)}"
    else:
        payload = f"TUPLE {random.randint(min_db, max_db)}"

    try:
        start_time = time.time()
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.connect((HOST, port))
            s.sendall(payload.encode('utf-8'))
            response = s.recv(1024).decode('utf-8')
        end_time = time.time()
        
        return {
            "round_trip_time_ms": (end_time - start_time) * 1000,
            "server_response": response.strip()
        }
    except Exception as e:
        return {"error": str(e)}

def run_simulation():
    print("=== PYTHON SIMULATOR CONFIGURATION ===")
    port = int(input("Enter server port to target (e.g., 8080): "))
    total_requests = int(input("Enter total simulation requests (e.g., 1000): "))
    concurrency = int(input("Enter concurrency batch limit (e.g., 50): "))
    
    print("\n-- Payload Generation Range Settings --")
    min_ip = int(input("Min IP integer range value: "))
    max_ip = int(input("Max IP integer range value: "))
    min_db = int(input("Min DB key integer range value: "))
    max_db = int(input("Max DB key integer range value: "))

    print(f"\n[Python Orchestrator] Starting simulation: {total_requests} requests with concurrency {concurrency}...")
    
    latencies = []
    start_global = time.time()

    # Batch execution loop to prevent thread/socket exhaustion
    for i in range(0, total_requests, concurrency):
        current_batch = min(concurrency, total_requests - i)
        with concurrent.futures.ThreadPoolExecutor(max_workers=current_batch) as executor:
            futures = [executor.submit(send_simulation_request, port, min_ip, max_ip, min_db, max_db) for _ in range(current_batch)]
            for future in concurrent.futures.as_completed(futures):
                res = future.result()
                if "round_trip_time_ms" in res:
                    latencies.append(res["round_trip_time_ms"])

    end_global = time.time()
    total_duration = end_global - start_global

    print("\n--- Simulation Benchmark Results ---")
    print(f"Total Time Elapsed: {total_duration:.4f} seconds")
    print(f"Throughput: {total_requests / total_duration:.2f} requests/sec")
    if latencies:
        print(f"Average Round-Trip Latency: {sum(latencies)/len(latencies):.4f} ms")
        print(f"Max Latency: {max(latencies):.4f} ms")
        print(f"Min Latency: {min(latencies):.4f} ms")

if __name__ == "__main__":
    run_simulation()

