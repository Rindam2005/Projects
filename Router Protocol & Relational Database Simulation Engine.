#include <unistd.h>

#define BUFFER_SIZE 1024

// --- Binary Search Tree (BST) for IP Routing Table ---
struct BSTNode {
    unsigned int ip_start;
    unsigned int ip_end;
    std::string next_hop;
    BSTNode* left;
    BSTNode* right;

    BSTNode(unsigned int start, unsigned int end, std::string hop) 
        : ip_start(start), ip_end(end), next_hop(hop), left(nullptr), right(nullptr) {}
};

class RoutingBST {
private:
    BSTNode* root;

    BSTNode* insert(BSTNode* node, unsigned int start, unsigned int end, const std::string& hop) {
        if (!node) return new BSTNode(start, end, hop);
        if (start < node->ip_start)
            node->left = insert(node->left, start, end, hop);
        else
            node->right = insert(node->right, start, end, hop);
        return node;
    }

    std::string search(BSTNode* node, unsigned int ip) {
        if (!node) return "DROPPED (No Route)";
        if (ip >= node->ip_start && ip <= node->ip_end)
            return node->next_hop;
        if (ip < node->ip_start)
            return search(node->left, ip);
        return search(node->right, ip);
    }

public:
    RoutingBST() : root(nullptr) {}

    void addRoute(unsigned int start, unsigned int end, const std::string& hop) {
        root = insert(root, start, end, hop);
    }

    std::string lookup(unsigned int ip) {
        return search(root, ip);
    }
};

// --- Socket Connection Handler ---
void handleClient(int client_socket, RoutingBST& rtable, const std::map<int, std::string>& tuple_database) {
    char buffer[BUFFER_SIZE] = {0};
    read(client_socket, buffer, BUFFER_SIZE);
    
    std::string request(buffer);
    std::stringstream ss(request);
    std::string type;
    unsigned int query_val;
    ss >> type >> query_val;

    std::string response;
    auto start_time = std::chrono::high_resolution_clock::now();

    if (type == "ROUTE") {
        response = "Route Next-Hop: " + rtable.lookup(query_val) + "\n";
    } else if (type == "TUPLE") {
        auto it = tuple_database.find(query_val);
        if (it != tuple_database.end()) {
            response = "Tuple Data: " + it->second + "\n";
        } else {
            response = "Tuple Data: NOT_FOUND\n";
        }
    } else {
        response = "ERROR: Unknown Command\n";
    }

    auto end_time = std::chrono::high_resolution_clock::now();
    auto duration = std::chrono::duration_cast<std::chrono::microseconds>(end_time - start_time).count();
    
    response += "Processing Latency (us): " + std::to_string(duration) + "\n";
    send(client_socket, response.c_str(), response.length(), 0);
    close(client_socket);
}

// --- Main Server Loop with User-Defined Configuration ---
int main() {
    int port;
    std::cout << "=== C++ ROUTER & DB ENGINE SETUP ===\n";
    std::cout << "Enter port number to run on (e.g., 8080): ";
    std::cin >> port;

    RoutingBST rtable;
    int num_routes;
    std::cout << "Enter number of custom routes to add to BST: ";
    std::cin >> num_routes;

    for (int i = 0; i < num_routes; ++i) {
        unsigned int start, end;
        std::string hop;
        std::cout << "Route " << (i + 1) << " [Start_IP_Int End_IP_Int Next_Hop_IP]: ";
        std::cin >> start >> end >> hop;
        rtable.addRoute(start, end, hop);
    }

    std::map<int, std::string> tuple_database;
    int num_tuples;
    std::cout << "Enter number of database tuples to initialize: ";
    std::cin >> num_tuples;

    for (int i = 0; i < num_tuples; ++i) {
        int key;
        std::string val;
        std::cout << "Tuple " << (i + 1) << " [Key_Int Value_String]: ";
        std::cin >> key >> val;
        tuple_database[key] = val;
    }

    int server_fd;
    struct sockaddr_in address;
    int opt = 1;
    int addrlen = sizeof(address);

    if ((server_fd = socket(AF_INET, SOCK_STREAM, 0)) == 0) {
        perror("Socket failed");
        exit(EXIT_FAILURE);
    }

    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR | SO_REUSEPORT, &opt, sizeof(opt));
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(port);

    if (bind(server_fd, (struct sockaddr*)&address, sizeof(address)) < 0) {
        perror("Bind failed");
        exit(EXIT_FAILURE);
    }

    if (listen(server_fd, 50) < 0) {
        perror("Listen failed");
        exit(EXIT_FAILURE);
    }

    std::cout << "\n[C++ Engine] Active and listening on port " << port << "...\n\n";

    while (true) {
        int client_socket;
        if ((client_socket = accept(server_fd, (struct sockaddr*)&address, (socklen_t*)&addrlen)) < 0) {
            continue;
        }
        std::thread(handleClient, client_socket, std::ref(rtable), std::cref(tuple_database)).detach();
    }

    return 0;
}

